+                details={"actions": actions_raw},
+            )
+        transaction_id = str(plan["transaction_id"])
+        txn_dir = (
+            paths.ledger_dir
+            / "_recovery"
+            / "allocation-repair-transactions"
+            / transaction_id
+        )
+        journal_path = txn_dir / "journal.json"
