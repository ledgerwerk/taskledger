+            older_than="1d",
+            apply=True,
+            reason="Attempt unsafe cleanup for regression coverage.",
+        )
+    assert outside.is_file()
+    with pytest.raises(LaunchError, match="canonical task ID"):
+        garbage_collect(workspace, scope="artifacts", task_id="../outside")
+
