+def test_task37_task38_task19_recovery_end_to_end(tmp_path: Path) -> None:
+    from taskledger.domain.models import DependencyRequirement, TaskRecord
+    from taskledger.services.doctor import (
+        inspect_v2_indexes,
+        inspect_v2_locks,
