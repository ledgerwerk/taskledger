+            "kind": "task_relation_repair",
+            "status": "dry_run",
+            "dry_run": True,
+            "changed": False,
+            **plan,
+            "next_command": (
+                "taskledger repair relation --task-uuid "
+                f"{canonical_uuid} --field {field}"
+                + (f" --requirement-id {requirement_id}" if requirement_id else "")
+                + f' --apply --plan-id {plan["plan_id"]} --reason "..."'
+            ),
+        }
