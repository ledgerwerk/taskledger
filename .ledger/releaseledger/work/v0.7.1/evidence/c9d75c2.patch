+        raise LaunchError(
+            "Relation repair source or mapping changed since dry-run; "
+            "inspect a fresh plan.",
+            code="TASKLEDGER_REPAIR_PLAN_CHANGED",
+            details={"expected_plan_id": plan_id, "current_plan_id": plan["plan_id"]},
+        )
